---
import { buildEpisodesSeoIndex } from "../../components/episodes/buildEpisodesSeoIndex";
import { EpisodesBrowser } from "../../components/episodes/EpisodesBrowser";
import EpisodesSeoIndex from "../../components/episodes/EpisodesSeoIndex.astro";
import { loadEpisodesBrowserDataFromFs } from "../../components/episodes/loadEpisodesBrowserDataFromFs";
import BaseLayout from "../../layouts/BaseLayout.astro";

const { browser } = loadEpisodesBrowserDataFromFs();
const seoEpisodes = buildEpisodesSeoIndex(browser);

const episodesDescription =
  "Browse YouTube's Eurovision Top 20: Most Watched episodes with detailed episode statistics";
---

<BaseLayout
  current="episodes"
  description={episodesDescription}
  title="Episodes"
>
  <EpisodesSeoIndex episodes={seoEpisodes} />
  <EpisodesBrowser client:visible />
</BaseLayout>
