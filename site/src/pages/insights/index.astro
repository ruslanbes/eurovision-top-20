---
import { computeRenderedInsights } from "../../components/insights/computeRenderedInsights";
import { InsightsPage } from "../../components/insights/InsightsPage";
import BaseLayout from "../../layouts/BaseLayout.astro";

const initialResults = computeRenderedInsights();

const insightsDescription =
  "Insights from YouTube's Eurovision Top 20: Most Watched statistics";
---

<BaseLayout
  current="insights"
  description={insightsDescription}
  title="Insights"
>
  <InsightsPage client:visible initialResults={initialResults} />
</BaseLayout>
